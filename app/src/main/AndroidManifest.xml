<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="Lords Capture v1"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.botvi.lords.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.botvi.lords.CaptureService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
            <service
            android:name="com.botvi.lords.ScanAccessibilityService"
            android:exported="false"
            android:label="Lords Capture — المسح الآلي"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/scan_accessibility" />
        </service>
    </application>
</manifest>
